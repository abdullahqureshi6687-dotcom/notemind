# Copy this file to .env and fill in the key for the provider you set in
# config.yaml (generation.provider). Only that one key is required.
# .env is git-ignored. Never commit real keys.

# generation.provider: gemini  -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# generation.provider: groq    -> https://console.groq.com/keys
GROQ_API_KEY=

# generation.provider: anthropic -> https://console.anthropic.com/
ANTHROPIC_API_KEY=

# generation.provider: openrouter -> https://openrouter.ai/keys  (free ":free" models)
OPENROUTER_API_KEY=

# generation.provider: mistral -> https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# generation.provider: ollama -> no key needed (runs on your own computer)

# Optional: use a different config file
# NOTEMIND_CONFIG=config.yaml
